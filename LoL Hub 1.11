-- Automatic Anti-Crash / Anti-Pipeline-Crash Protection Loop
local function SetupAntiCrash()
    pcall(function()
        local scriptContext = game:GetService("ScriptContext")
        scriptContext.Error:Connect(function(message, stackTrace, script)
            -- Suppress or handle pipeline overload and memory spike errors automatically
            if message and (string.find(message, "pipeline") or string.find(message, "memory") or string.find(message, "overflow")) then
                warn("[Auto Anti-Crash]: Intercepted pipeline/crash warning. Mitigating...")
            end
        end)
    end)
    
    -- Automatic garbage collection boost to avoid frame drops and memory-based crashes
    task.spawn(function()
        while task.wait(30) do
            pcall(function()
                collectgarbage("collect")
            end)
        end
    end)
end

SetupAntiCrash()

